{
  "name": "review-evidence-publisher",
  "version": "0.1.0",
  "description": "Publish and verify review captures for a source commit using GitHub Actions artifacts.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "review-evidence": "./bin/review-evidence.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick-cobra/review-evidence-publisher.git"
  },
  "files": [
    "index.mjs",
    "lib/",
    "bin/",
    "action.yml",
    "actions/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "yaml": "2.9.1"
  }
}
